enum Species {
  DOG
  CAT
}

type Pet {
  id: ID!
  name: String!
  species: Species!
  age: Int
  owner: Owner
}

type Owner {
  name: String!
  pets: [Pet!]!
}

type Shelter {
  name: String!
  capacity: Int!
}

union Home = Owner | Shelter

type Query {
  pets(species: Species, first: Int): [Pet!]!
  pet(id: ID!): Pet
  home(pet: ID!): Home
}
